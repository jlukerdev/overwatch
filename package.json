{
  "name": "view-protect",
  "productName": "OverWatch",
  "version": "1.0.2",
  "private": true,
  "description": "OverWatch: live camera grid Views for UniFi Protect or RTSP cameras, for Windows and macOS.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/electron-vite.ts dev",
    "build": "npm run typecheck && node scripts/electron-vite.ts build",
    "preview": "node scripts/electron-vite.ts preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:spike": "tsc --noEmit -p scripts/spikes/video-spike/renderer/tsconfig.json",
    "typecheck": "npm run check:protect-types && npm run typecheck:node && npm run typecheck:web && npm run typecheck:spike",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch:go2rtc": "node scripts/fetch-go2rtc.ts",
    "gen:protect-types": "node scripts/gen-protect-types.ts",
    "check:protect-types": "node scripts/gen-protect-types.ts --check",
    "gen:icons": "node scripts/gen-icons.ts",
    "predist": "npm run fetch:go2rtc -- --all",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run dist -- --mac",
    "dist:win": "npm run dist -- --win",
    "dist:all": "npm run dist -- --mac --win",
    "postinstall": "install-electron",
    "spike:protect": "node scripts/spikes/protect-spike.ts",
    "spike:scan": "node scripts/spikes/scan-fixtures.ts",
    "spike:access": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/spikes/access-spike.ts",
    "spike:video": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/spikes/video-spike/launch.ts",
    "perf": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/perf/run.ts",
    "mock:access": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/mock-access/server.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "undici": "^7.30.2",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
