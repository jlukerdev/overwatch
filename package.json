{
  "name": "view-protect",
  "productName": "View Protect",
  "version": "0.1.0",
  "private": true,
  "description": "Live UniFi Protect camera grid Views for Windows and macOS.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run check:protect-types && npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch:go2rtc": "node scripts/fetch-go2rtc.ts",
    "gen:protect-types": "node scripts/gen-protect-types.ts",
    "check:protect-types": "node scripts/gen-protect-types.ts --check",
    "predist": "npm run fetch:go2rtc -- --all",
    "dist": "npm run build && electron-builder",
    "postinstall": "install-electron",
    "spike:protect": "node scripts/spikes/protect-spike.ts",
    "spike:scan": "node scripts/spikes/scan-fixtures.ts",
    "spike:access": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/spikes/access-spike.ts",
    "mock:access": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/mock-access/server.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "undici": "^7.30.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
