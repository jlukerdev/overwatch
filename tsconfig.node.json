{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    // scripts/*.ts run directly under Node type stripping: .ts import paths, erasable syntax only.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "tests/unit/**/*",
    "scripts/**/*.ts",
    "electron.vite.config.ts",
    "vitest.config.mts"
  ],
  // Browser code with its own tsconfig (DOM lib): npm run typecheck:spike.
  "exclude": ["scripts/spikes/video-spike/renderer/**"]
}
